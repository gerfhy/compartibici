@model IEnumerable<CompartiBici.Models.Incidencia>
@{
    ViewData["Title"] = "Centro Operativo de Incidencias";
}

<div class="py-4">
    <!-- Header with Aerion Typography -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom gap-3">
        <div>
            <div class="text-uppercase small fw-bold text-muted mb-1" style="letter-spacing: 0.1em;">
                <span class="brand-asterisk">✱</span> Plataforma de Telemetría y Operaciones
            </div>
            <h1 class="font-display fw-bold display-5 text-dark mb-0" style="letter-spacing: -0.01em;">Incidencias abiertas (Búsqueda Algolia, Caché Redis y Tiempo Real PieHost)</h1>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <!-- WebSocket Live Badge -->
            <span id="ws-status-badge" class="cb-pill-tag bg-white shadow-sm border py-2 px-3">
                <span class="spinner-grow spinner-grow-sm text-warning me-2" role="status" style="width: 10px; height: 10px;"></span>
                Conectando WebSocket...
            </span>

            <!-- Redis Cache Status Badge -->
            @if (ViewBag.OrigenLectura == "REDIS (CACHÉ)")
            {
                <span class="cb-pill-tag neon shadow-sm py-2 px-3 fw-bold" id="cache-status-badge">
                    ⚡ REDIS CLOUD (HIT - 60s)
                </span>
            }
            else if (ViewBag.OrigenLectura == "ALGOLIA DIRECTO")
            {
                <span class="cb-pill-tag blue shadow-sm py-2 px-3 fw-bold" id="cache-status-badge">
                    🔍 ALGOLIA DIRECTO (SIN CACHÉ)
                </span>
            }
            else
            {
                <span class="cb-pill-tag dark shadow-sm py-2 px-3 fw-bold" id="cache-status-badge">
                    🗄️ SQLITE (CACHÉ MISS)
                </span>
            }

            <!-- Open Incidents Counter Badge -->
            <span class="cb-pill-tag dark shadow-sm py-2 px-3 fs-6">
                Abiertas: <span id="contador-abiertas" class="badge rounded-pill bg-danger ms-1">@Model.Count()</span>
            </span>
        </div>
    </div>

    <!-- Live Toast Container -->
    <div id="live-alert-container" class="mb-3"></div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4 alert-dismissible fade show" role="alert" style="background-color: #dcfce7; color: #166534;">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5">✓</span>
                <div>@TempData["Mensaje"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search Section (Algolia Engine) -->
    <div class="cb-card p-3 p-lg-4 mb-4">
        <form method="get" asp-action="Incidencias" class="row g-2 align-items-center">
            <div class="col-md-9 col-sm-8">
                <div class="cb-search-box">
                    <span class="text-muted me-2 fs-5">🔍</span>
                    <input type="text" name="q" value="@ViewBag.Busqueda" class="cb-search-input" 
                           placeholder="Búsqueda instantánea con Algolia (ej: Miraflores, freno, cadena, batería)..." />
                </div>
            </div>
            <div class="col-md-3 col-sm-4 d-flex gap-2">
                <button type="submit" class="btn-cb-neon w-100">
                    Buscar Algolia
                </button>
                @if (!string.IsNullOrWhiteSpace(ViewBag.Busqueda as string))
                {
                    <a asp-action="Incidencias" class="btn-cb-outline">Limpiar</a>
                }
            </div>
        </form>
        @if (!string.IsNullOrWhiteSpace(ViewBag.Busqueda as string))
        {
            <div class="mt-3 ps-2 d-flex align-items-center gap-2">
                <span class="badge bg-light text-dark border rounded-pill px-3 py-1">
                    Filtro activo: <strong>"@ViewBag.Busqueda"</strong>
                </span>
                <span class="text-muted small">Resultados devueltos por el índice de Algolia y filtrados en BD.</span>
            </div>
        }
    </div>

    <!-- Incidents Table Card -->
    <div class="cb-card overflow-hidden">
        <div class="table-responsive">
            <table class="cb-table" id="tabla-incidencias">
                <thead>
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Estación</th>
                        <th>Descripción de Avería</th>
                        <th>Prioridad</th>
                        <th>Estado</th>
                        <th>Registro</th>
                        <th class="text-end pe-4">Acción Supervisor</th>
                    </tr>
                </thead>
                <tbody id="lista-incidencias-body">
                    @if (!Model.Any())
                    {
                        <tr id="fila-vacia">
                            <td colspan="7" class="text-center py-5 text-muted">
                                <div class="fs-1 mb-2">🚲</div>
                                <div class="fw-bold fs-5 text-dark">No hay averías abiertas pendientes</div>
                                <div class="small text-muted">Todas las estaciones operan con normalidad.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr id="incidencia-row-@item.Id">
                                <td class="ps-4">
                                    <span class="cb-pill-tag dark px-2 py-1 small">#@item.Id</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.Estacion</div>
                                </td>
                                <td>
                                    <span class="text-secondary">@item.Descripcion</span>
                                </td>
                                <td>
                                    @if (item.Prioridad == "Alta")
                                    {
                                        <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 fw-bold">Alta</span>
                                    }
                                    else if (item.Prioridad == "Media")
                                    {
                                        <span class="badge rounded-pill bg-warning-subtle text-dark border border-warning-subtle px-3 py-1 fw-bold" style="background-color: #fef08a !important;">Media</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-info-subtle text-primary border border-info-subtle px-3 py-1 fw-bold">Baja</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-1 fw-bold">
                                        ● @item.Estado
                                    </span>
                                </td>
                                <td class="text-muted small">
                                    @item.FechaRegistro.ToString("yyyy-MM-dd HH:mm")
                                </td>
                                <td class="text-end pe-4">
                                    <form asp-action="CerrarIncidencia" asp-route-id="@item.Id" method="post" class="d-inline form-cerrar">
                                        <button type="submit" class="btn-cb-close">
                                            Cerrar Incidencia
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        const clusterId = "@ViewBag.PieSocketCluster" || "free.blr2";
        const apiKey = "@ViewBag.PieSocketApiKey" || "DNHnT7FNMDzgRPwTvT482A1mnvsx1t99rlRDX8oh";
        const roomId = "@ViewBag.PieSocketRoom" || "incidencias_canal";

        const badge = document.getElementById("ws-status-badge");
        const contador = document.getElementById("contador-abiertas");
        const alertContainer = document.getElementById("live-alert-container");
        const tbody = document.getElementById("lista-incidencias-body");

        let socket = null;
        let isFirstConnection = true;

        function mostrarAlerta(mensaje, tipo = "info") {
            const alertDiv = document.createElement("div");
            alertDiv.className = `alert alert-${tipo} border-0 shadow-sm rounded-4 alert-dismissible fade show`;
            alertDiv.role = "alert";
            alertDiv.style.backgroundColor = tipo === "warning" ? "#fef3c7" : (tipo === "success" ? "#dcfce7" : "#e0e7ff");
            alertDiv.style.color = tipo === "warning" ? "#92400e" : (tipo === "success" ? "#166534" : "#3730a3");
            alertDiv.innerHTML = `
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-5">⚡</span>
                    <div><strong>Tiempo Real (PieHost):</strong> ${mensaje}</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            `;
            alertContainer.prepend(alertDiv);
            setTimeout(() => {
                alertDiv.classList.remove("show");
                setTimeout(() => alertDiv.remove(), 500);
            }, 6000);
        }

        // Consultar estado vigente al reconectar
        async function sincronizarEstadoVigente() {
            try {
                const res = await fetch("/Operaciones/ObtenerIncidenciasJson");
                if (res.ok) {
                    const incidencias = await res.json();
                    renderizarTabla(incidencias);
                    contador.textContent = incidencias.length;
                    mostrarAlerta("Estado vigente sincronizado tras reconexión.", "success");
                }
            } catch (err) {
                console.error("Error al sincronizar estado vigente:", err);
            }
        }

        function renderizarTabla(incidencias) {
            tbody.innerHTML = "";
            if (!incidencias || incidencias.length === 0) {
                tbody.innerHTML = `
                    <tr id="fila-vacia">
                        <td colspan="7" class="text-center py-5 text-muted">
                            <div class="fs-1 mb-2">🚲</div>
                            <div class="fw-bold fs-5 text-dark">No hay averías abiertas pendientes</div>
                            <div class="small text-muted">Todas las estaciones operan con normalidad.</div>
                        </td>
                    </tr>`;
                return;
            }

            incidencias.forEach(item => {
                let badgeClass = "bg-info-subtle text-primary border-info-subtle";
                if (item.prioridad === "Alta") badgeClass = "bg-danger-subtle text-danger border-danger-subtle";
                else if (item.prioridad === "Media") badgeClass = "bg-warning-subtle text-dark border-warning-subtle";

                const row = document.createElement("tr");
                row.id = `incidencia-row-${item.id}`;
                row.innerHTML = `
                    <td class="ps-4">
                        <span class="cb-pill-tag dark px-2 py-1 small">#${item.id}</span>
                    </td>
                    <td><div class="fw-bold text-dark">${item.estacion}</div></td>
                    <td><span class="text-secondary">${item.descripcion}</span></td>
                    <td><span class="badge rounded-pill ${badgeClass} border px-3 py-1 fw-bold">${item.prioridad}</span></td>
                    <td><span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-1 fw-bold">● ${item.estado}</span></td>
                    <td class="text-muted small">${new Date(item.fechaRegistro).toLocaleString()}</td>
                    <td class="text-end pe-4">
                        <form action="/Operaciones/CerrarIncidencia/${item.id}" method="post" class="d-inline form-cerrar">
                            <button type="submit" class="btn-cb-close">Cerrar Incidencia</button>
                        </form>
                    </td>
                `;
                tbody.appendChild(row);
            });
        }

        function procesarEvento(evento, data) {
            if (evento === "IncidenciaActualizada" && data) {
                const incidenciaId = data.Id || data.id;
                const estado = data.Estado || data.estado;

                if (estado === "Cerrada") {
                    const row = document.getElementById(`incidencia-row-${incidenciaId}`);
                    if (row) {
                        row.style.transition = "all 0.6s ease";
                        row.style.backgroundColor = "#fee2e2";
                        row.style.opacity = "0";

                        setTimeout(() => {
                            row.remove();
                            const currentCount = parseInt(contador.textContent || "0");
                            contador.textContent = Math.max(0, currentCount - 1);

                            if (tbody.querySelectorAll("tr").length === 0) {
                                renderizarTabla([]);
                            }
                        }, 600);

                        mostrarAlerta(`Incidencia #${incidenciaId} fue cerrada en tiempo real por el supervisor.`, "warning");
                    }
                }
            }
        }

        function conectarWebSocket() {
            if (!apiKey) {
                badge.className = "cb-pill-tag bg-white text-danger border py-2 px-3 shadow-sm";
                badge.textContent = "❌ ApiKey no disponible";
                return;
            }

            const wsUrl = `wss://${clusterId}.piesocket.com/v4/${roomId}?api_key=${apiKey}&notify_self=1`;
            socket = new WebSocket(wsUrl);

            socket.onopen = function () {
                badge.className = "cb-pill-tag neon shadow-sm py-2 px-3 fw-bold";
                badge.innerHTML = `<span class="live-pulse-dot me-2"></span>PieHost En Vivo`;

                if (!isFirstConnection) {
                    sincronizarEstadoVigente();
                }
                isFirstConnection = false;
            };

            socket.onmessage = function (event) {
                try {
                    const parsed = JSON.parse(event.data);
                    if (parsed.event && parsed.data) {
                        procesarEvento(parsed.event, parsed.data);
                    } else if (parsed.message) {
                        const inner = typeof parsed.message === "string" ? JSON.parse(parsed.message) : parsed.message;
                        if (inner.event && inner.data) {
                            procesarEvento(inner.event, inner.data);
                        }
                    }
                } catch (e) {
                    console.log("Mensaje WebSocket recibido:", event.data);
                }
            };

            socket.onclose = function () {
                badge.className = "cb-pill-tag bg-white text-warning border py-2 px-3 shadow-sm";
                badge.innerHTML = `🟡 Reconectando WebSocket...`;
                setTimeout(conectarWebSocket, 3000);
            };

            socket.onerror = function (err) {
                console.error("Error en conexión WebSocket:", err);
                socket.close();
            };
        }

        conectarWebSocket();
    })();
</script>
}
