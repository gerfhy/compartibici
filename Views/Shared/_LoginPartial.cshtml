@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<div class="d-flex align-items-center gap-2">
@if (SignInManager.IsSignedIn(User))
{
    <span class="cb-pill-tag dark me-1">
        <span class="live-pulse-dot me-2"></span>
        @User.Identity?.Name
    </span>
    <form class="form-inline d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
        <button type="submit" class="btn-cb-outline btn-sm">Salir</button>
    </form>
}
else
{
    <a class="btn-cb-outline" asp-area="Identity" asp-page="/Account/Login">Acceder</a>
    <a class="btn-cb-neon" asp-area="" asp-controller="Operaciones" asp-action="Incidencias">
        <span>Panel Operativo</span> ➔
    </a>
}
</div>
